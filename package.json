{
  "name": "usdt-invoice-demo",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Dashboard local în română pentru facturi și reconciliere USDt simulate",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "test:simulation": "node --test tests/ledger.test.mjs tests/server.test.mjs tests/storage.test.mjs",
    "test:wdk": "node --test tests/testnet.test.mjs",
    "verify:live": "node scripts/live-check.mjs",
    "audit:online": "node scripts/audit-online.mjs"
  },
  "dependencies": {
    "@tetherto/wdk-wallet-evm": "1.0.0-beta.20"
  }
}
