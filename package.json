{
  "name": "usdt-invoice-demo",
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Facturi USDt simulate și verificare WDK read-only a USDC de test pe Sepolia; fără semnare sau fonduri reale",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "test:simulation": "node --test tests/ledger.test.mjs tests/server.test.mjs tests/storage.test.mjs",
    "test:wdk": "node --test tests/testnet.test.mjs",
    "verify:live": "node scripts/live-check.mjs",
    "audit:online": "node scripts/audit-online.mjs",
    "scan:history": "node scripts/scan-history.mjs"
  },
  "dependencies": {
    "@tetherto/wdk-wallet-evm": "1.0.0-beta.20"
  }
}
